@page "/"
@inject CatalogService Catalog
@inject RateService Rates
@inject RaiseCalculator Calculator
@implements IDisposable

<PageTitle>Raise Planner · Hatchly</PageTitle>

<header class="page-heading">
    <div>
        <span class="eyebrow">ASA raise planner</span>
        <h1>Plan your next raise</h1>
        <p>Know what a full inventory can hold, when the baby reaches juvenile, and how much food the full raise needs.</p>
    </div>
</header>

@if (Catalog.Error is not null)
{
    <section class="card empty-state" role="alert">
        <h2>Creature data could not be loaded</h2>
        <p>@Catalog.Error</p>
    </section>
}
else if (Catalog.Catalog is null)
{
    <section class="card loading-card" aria-live="polite">
        <span class="loading-dot"></span>
        <p>Loading current creature data and server rates…</p>
    </section>
}
else if (Rates.CurrentRates is null)
{
    <section class="card empty-state error" role="alert">
        <h2>Official calculations are unavailable</h2>
        <p>@Rates.Error Select Unofficial in the header to enter rates manually, or reload to try the bundled file again.</p>
    </section>
}
else
{
    <section class="mobile-quick-setup" aria-label="Raise setup">
        <div class="mobile-creature-card">
            <span class="mobile-creature-icon" aria-hidden="true">◆</span>
            <label>
                <span>Creature</span>
                <select @bind="selectedCreatureId" @bind:after="CreatureChanged">
                    @foreach (var creature in Catalog.Catalog.Creatures)
                    {
                        <option value="@creature.Id">@creature.Name</option>
                    }
                </select>
            </label>
            <span class="mobile-creature-meta">@FormatPercent(maturityPercent) maturity · @adultWeight.ToString("0") weight</span>
        </div>

        <section class="mobile-settings" aria-label="Raise settings">
            <div class="mobile-settings-title">
                <h2>Raise settings</h2>
                <p>Maturity, weight, and food drive every result below.</p>
            </div>
            <div class="form-stack">
                <label>
                    <span>Current maturity</span>
                    <div class="input-with-suffix">
                        <input type="number" min="0" max="100" step="0.1"
                               @bind="maturityPercent"
                               @bind:event="oninput"
                               @bind:after="Recalculate" />
                        <span>%</span>
                    </div>
                </label>
                <label>
                    <span>Adult Weight stat</span>
                    <input type="number" min="1" step="1"
                           @bind="adultWeight"
                           @bind:event="oninput"
                           @bind:after="Recalculate" />
                </label>
                <label>
                    <span>Food</span>
                    <select @bind="selectedFoodId" @bind:after="Recalculate">
                        @foreach (var food in AvailableFoods)
                        {
                            <option value="@food.Id">@food.Name</option>
                        }
                    </select>
                </label>
                @if (Rates.SelectedServer == ServerSelection.Unofficial)
                {
                    <div class="three-column-fields">
                        <label>
                            <span>Hatch</span>
                            <input type="number" min="0.01" step="0.01"
                                   @bind="unofficialHatch"
                                   @bind:after="SaveUnofficialAsync" />
                        </label>
                        <label>
                            <span>Mature</span>
                            <input type="number" min="0.01" step="0.01"
                                   @bind="unofficialMature"
                                   @bind:after="SaveUnofficialAsync" />
                        </label>
                        <label>
                            <span>Consume</span>
                            <input type="number" min="0.01" step="0.01"
                                   @bind="unofficialConsume"
                                   @bind:after="SaveUnofficialAsync" />
                        </label>
                    </div>
                }
                @if (CurrentCreature.SpecialBehavior == "elderclaw-crop-plot")
                {
                    <fieldset class="special-settings">
                        <legend>Elderclaw growth conditions</legend>
                        <label>
                            <span>Greenhouse effect</span>
                            <div class="input-with-suffix">
                                <input type="number" min="0" max="300" step="1"
                                       @bind="greenhousePercent"
                                       @bind:event="oninput"
                                       @bind:after="Recalculate" />
                                <span>%</span>
                            </div>
                        </label>
                        <label class="check-row">
                            <input type="checkbox"
                                   @bind="shovelTilled"
                                   @bind:after="Recalculate" />
                            <span>Apply the 30% shovel tilling bonus</span>
                        </label>
                    </fieldset>
                }
            </div>
        </section>

        @if (maturityPercent < JuvenileThresholdPercent)
        {
            <fieldset class="mobile-buffer-card">
                <legend>Desired feeding buffer</legend>
                <div class="duration-fields">
                    <label>
                        <span>Hours</span>
                        <input type="number" min="0" max="168" step="1"
                               @bind="bufferHours"
                               @bind:event="oninput"
                               @bind:after="Recalculate" />
                    </label>
                    <label>
                        <span>Minutes</span>
                        <input type="number" min="0" max="59" step="1"
                               @bind="bufferMinutes"
                               @bind:event="oninput"
                               @bind:after="Recalculate" />
                    </label>
                </div>
            </fieldset>
        }
    </section>

    @if (RequiresRenderedBloodPackWarning)
    {
        <section class="global-notice warning contextual-warning" role="alert">
            <span class="contextual-warning-icon" aria-hidden="true">!</span>
            <div>
                <strong>Keep this Blood Pack raise rendered</strong>
                <p>
                    @CurrentCreature.Name must remain in player render range while feeding on Blood Packs.
                    Current server behavior does not process this food reliably while the creature is unrendered, and it can starve.
                </p>
            </div>
        </section>
    }

    <div class="planner-grid">
        <section class="card setup-card">
            <div class="section-title">
                <span class="section-icon" aria-hidden="true">☷</span>
                <div>
                    <h2>Raise setup</h2>
                    <p>Changes recalculate immediately.</p>
                </div>
            </div>

            @if (Rates.SelectedServer == ServerSelection.Unofficial)
            {
                <fieldset class="unofficial-rates">
                    <legend>Unofficial server rates</legend>
                    <div class="three-column-fields">
                        <label>
                            <span>Hatch</span>
                            <input type="number" min="0.01" step="0.01"
                                   @bind="unofficialHatch"
                                   @bind:after="SaveUnofficialAsync" />
                        </label>
                        <label>
                            <span>Mature</span>
                            <input type="number" min="0.01" step="0.01"
                                   @bind="unofficialMature"
                                   @bind:after="SaveUnofficialAsync" />
                        </label>
                        <label>
                            <span>Consume</span>
                            <input type="number" min="0.01" step="0.01"
                                   @bind="unofficialConsume"
                                   @bind:after="SaveUnofficialAsync" />
                        </label>
                    </div>
                </fieldset>
            }

            <div class="form-stack">
                <label>
                    <span>Creature</span>
                    <select @bind="selectedCreatureId" @bind:after="CreatureChanged">
                        @foreach (var creature in Catalog.Catalog.Creatures)
                        {
                            <option value="@creature.Id">@creature.Name</option>
                        }
                    </select>
                </label>

                <label>
                    <span>Current maturity</span>
                    <div class="input-with-suffix">
                        <input type="number" min="0" max="100" step="0.1"
                               @bind="maturityPercent"
                               @bind:event="oninput"
                               @bind:after="Recalculate" />
                        <span>%</span>
                    </div>
                </label>

                @if (maturityPercent < JuvenileThresholdPercent)
                {
                    <fieldset class="buffer-fieldset">
                        <legend>Desired feeding buffer</legend>
                        <div class="duration-fields">
                            <label>
                                <span>Hours</span>
                                <input type="number" min="0" max="168" step="1"
                                       @bind="bufferHours"
                                       @bind:event="oninput"
                                       @bind:after="Recalculate" />
                            </label>
                            <label>
                                <span>Minutes</span>
                                <input type="number" min="0" max="59" step="1"
                                       @bind="bufferMinutes"
                                       @bind:event="oninput"
                                       @bind:after="Recalculate" />
                            </label>
                        </div>
                        <p class="field-help">How long you want to go between full inventory refills before juvenile.</p>
                    </fieldset>
                }

                <label>
                    <span>Adult Weight stat</span>
                    <input type="number" min="1" step="1"
                           @bind="adultWeight"
                           @bind:event="oninput"
                           @bind:after="Recalculate" />
                </label>

                <label>
                    <span>Food</span>
                    <select @bind="selectedFoodId" @bind:after="Recalculate">
                        @foreach (var food in AvailableFoods)
                        {
                            <option value="@food.Id">@food.Name</option>
                        }
                    </select>
                </label>
            </div>

            @if (CurrentCreature.SpecialBehavior == "elderclaw-crop-plot")
            {
                <fieldset class="special-settings">
                    <legend>Elderclaw growth conditions</legend>
                    <label>
                        <span>Greenhouse effect</span>
                        <div class="input-with-suffix">
                            <input type="number" min="0" max="300" step="1"
                                   @bind="greenhousePercent"
                                   @bind:event="oninput"
                                   @bind:after="Recalculate" />
                            <span>%</span>
                        </div>
                    </label>
                    <label class="check-row">
                        <input type="checkbox"
                               @bind="shovelTilled"
                               @bind:after="Recalculate" />
                        <span>Apply the 30% shovel tilling bonus</span>
                    </label>
                </fieldset>
            }
        </section>

        <div class="results-column dashboard-grid">
            @if (calculationError is not null)
            {
                <section class="card empty-state error" role="alert">
                    <h2>Calculation unavailable</h2>
                    <p>@calculationError</p>
                </section>
            }
            else if (plan is not null)
            {
                <section class="card feeding-result @FeedingTone">
                    @if (plan.Feeding.Status == FeedingBufferStatus.Juvenile)
                    {
                        <div class="result-heading">
                            <span class="status-symbol" aria-hidden="true">✓</span>
                            <div>
                                <span class="eyebrow">@CurrentPhase phase</span>
                                <h2>@JuvenileHeadline</h2>
                                <p>@JuvenileSupportingText</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="result-heading">
                            <span class="status-symbol" aria-hidden="true">@FeedingSymbol</span>
                            <div>
                                <span class="eyebrow">@FeedingEyebrow</span>
                                <h2>@FeedingHeadline</h2>
                                <p>@FeedingSupportingText</p>
                            </div>
                        </div>
                    }

                    <div class="hero-metrics">
                        @if (plan.Feeding.Status == FeedingBufferStatus.Juvenile)
                        {
                            <div>
                                <span>Current maturity</span>
                                <strong>@FormatPercent(maturityPercent)</strong>
                                <small>@CurrentPhase phase</small>
                            </div>
                            <div>
                                <span>@NextMaturationMilestoneLabel</span>
                                <strong>@FormatDuration(NextMaturationMilestoneDuration)</strong>
                                <small>@NextMaturationMilestoneHelp</small>
                            </div>
                            <div>
                                <span>Food remaining</span>
                                <strong>@plan.FoodToAdult</strong>
                                <small>@CurrentFood.Name through adulthood</small>
                            </div>
                        }
                        else
                        {
                            <div>
                                <span>Juvenile in</span>
                                <strong>@FormatDuration(plan.Lifecycle.TimeToJuvenile)</strong>
                                <small>At @FormatPercent(JuvenileThresholdPercent)</small>
                            </div>
                            <div>
                                <span>Adult in</span>
                                <strong>@FormatDuration(plan.Lifecycle.TimeToAdult)</strong>
                                <small>Remaining maturation</small>
                            </div>
                            <div>
                                <span>Current buffer</span>
                                <strong>@FormatDuration(plan.Feeding.FullInventoryDuration)</strong>
                                <small>@plan.Feeding.FullItemQuantity @CurrentFood.Name if full now</small>
                            </div>
                        }
                    </div>

                    <div class="lifecycle-track" aria-label="Maturation progress">
                        <div class="track-captions">
                            <span>@BirthTrackLabel</span>
                            <span>Adult</span>
                        </div>
                        <div class="phase-rail" aria-hidden="true">
                            <span class="track-progress" style="@MaturityStyle"></span>
                            <span class="phase-boundary juvenile @TrackBoundaryState(JuvenileThresholdPercent)" style="@JuvenileTrackStyle"></span>
                            <span class="phase-boundary adolescent @TrackBoundaryState(AdolescentThresholdPercent)"></span>
                            <span class="phase-boundary adult @TrackBoundaryState(100)"></span>
                        </div>
                        <div class="phase-labels">
                            <span class='phase-label @PhaseLabelState("Baby")'>
                                <strong>Baby</strong>
                                <small>0-@FormatPercent(JuvenileThresholdPercent)</small>
                            </span>
                            <span class='phase-label @PhaseLabelState("Juvenile")'>
                                <strong>Juvenile</strong>
                                <small>@FormatPercent(JuvenileThresholdPercent)-@FormatPercent(AdolescentThresholdPercent)</small>
                            </span>
                            <span class='phase-label @PhaseLabelState("Adolescent")'>
                                <strong>Adolescent</strong>
                                <small>@FormatPercent(AdolescentThresholdPercent)-100%</small>
                            </span>
                        </div>
                    </div>

                    @if (plan.Feeding.Status == FeedingBufferStatus.Juvenile)
                    {
                        <details class="feeding-details">
                            <summary>Current feeding details</summary>
                            <dl class="feeding-facts">
                                <div>
                                    <dt>Current consumption</dt>
                                    <dd>@plan.CurrentFoodPointsPerMinute.ToString("0.##") food points/min</dd>
                                </div>
                                <div>
                                    <dt>Selected food rate</dt>
                                    <dd>@ItemsPerHour.ToString("0.##") @CurrentFood.Name/hour</dd>
                                </div>
                                <div>
                                    <dt>Estimated daily food</dt>
                                    <dd>@ItemsPerDay.ToString("0") @CurrentFood.Name/day</dd>
                                </div>
                                <div>
                                    <dt>Food until adult</dt>
                                    <dd>@plan.FoodToAdult @CurrentFood.Name</dd>
                                </div>
                                <div>
                                    <dt>Elapsed maturation</dt>
                                    <dd>@FormatDuration(plan.Lifecycle.ElapsedMaturation)</dd>
                                </div>
                                <div>
                                    <dt>Remaining maturation</dt>
                                    <dd>@FormatDuration(plan.Lifecycle.RemainingMaturation)</dd>
                                </div>
                            </dl>
                        </details>
                    }
                    else
                    {
                        <details class="feeding-details" open>
                            <summary>Feeding capacity details</summary>
                            <dl class="feeding-facts">
                                <div>
                                    <dt>Desired buffer</dt>
                                    <dd>@FormatDuration(DesiredBuffer)</dd>
                                </div>
                                <div>
                                    <dt>If filled now, lasts until</dt>
                                    <dd>@plan.Feeding.IfFilledUntil.ToString("h:mm tt")</dd>
                                </div>
                                <div>
                                    <dt>Target possible in</dt>
                                    <dd>@FormatDuration(plan.Feeding.TimeUntilTargetAvailable)</dd>
                                </div>
                                <div>
                                    <dt>Target maturity</dt>
                                    <dd>@FormatPercent(plan.Feeding.TargetAvailableMaturityPercent)</dd>
                                </div>
                                <div>
                                    <dt>Full quantity at target</dt>
                                    <dd>@plan.Feeding.TargetAvailableItemQuantity @CurrentFood.Name</dd>
                                </div>
                                <div>
                                    <dt>Hand feed until</dt>
                                    <dd>@FormatDuration(plan.Feeding.TimeUntilLastFullInventory)</dd>
                                </div>
                                <div>
                                    <dt>Hand feed until maturity</dt>
                                    <dd>@FormatPercent(plan.Feeding.LastFullInventoryMaturityPercent)</dd>
                                </div>
                                <div>
                                    <dt>Final refill amount</dt>
                                    <dd>@plan.Feeding.LastFullInventoryItemQuantity @CurrentFood.Name</dd>
                                </div>
                                <div>
                                    <dt>Consumed before juvenile</dt>
                                    <dd>@plan.Feeding.FoodConsumedBeforeJuvenile @CurrentFood.Name</dd>
                                </div>
                            </dl>
                        </details>
                    }
                </section>

                <section class="card lifecycle-card">
                    <div class="section-title compact">
                        <span class="section-icon" aria-hidden="true">◷</span>
                        <div>
                            <h2>Raise timeline</h2>
                            <p>From birth through adulthood.</p>
                        </div>
                    </div>

                    <dl class="timeline-list">
                        <div>
                            <dt>@plan.Lifecycle.BirthLabel</dt>
                            <dd>@FormatDuration(plan.Lifecycle.BirthDuration)</dd>
                        </div>
                        <div>
                            <dt>Baby phase</dt>
                            <dd>@FormatDuration(plan.Lifecycle.BabyPhaseDuration)</dd>
                        </div>
                        <div>
                            <dt>Juvenile phase</dt>
                            <dd>@FormatDuration(plan.Lifecycle.JuvenilePhaseDuration)</dd>
                        </div>
                        <div>
                            <dt>Adolescent phase</dt>
                            <dd>@FormatDuration(plan.Lifecycle.AdolescentPhaseDuration)</dd>
                        </div>
                        <div class="timeline-total">
                            <dt>Total raise time</dt>
                            <dd>@FormatDuration(plan.Lifecycle.BirthToAdultDuration)</dd>
                        </div>
                        <div class="emphasis">
                            <dt>Remaining</dt>
                            <dd>@FormatDuration(plan.Lifecycle.RemainingMaturation)</dd>
                        </div>
                    </dl>
                </section>

                <section class="card next-actions">
                    <div class="section-title compact">
                        <span class="section-icon" aria-hidden="true">◎</span>
                        <div>
                            <h2>Next actions</h2>
                            <p>@(plan.Feeding.Status == FeedingBufferStatus.Juvenile ? "Based on current maturity and consumption." : "Based on a full baby inventory.")</p>
                        </div>
                    </div>

                    @if (plan.Feeding.Status != FeedingBufferStatus.Juvenile)
                    {
                        <div class="action-item">
                            <span class="action-icon amber" aria-hidden="true">◷</span>
                            <div>
                                <strong>Fill with @plan.Feeding.FullItemQuantity @CurrentFood.Name</strong>
                                <span>If filled now, it lasts until @plan.Feeding.IfFilledUntil.ToString("h:mm tt")</span>
                            </div>
                        </div>

                        @if (plan.Feeding.Status == FeedingBufferStatus.TargetAvailableLater)
                        {
                            <div class="action-item">
                                <span class="action-icon green" aria-hidden="true">✓</span>
                                <div>
                                    <strong>@FormatDuration(DesiredBuffer) buffer at @FormatPercent(plan.Feeding.TargetAvailableMaturityPercent)</strong>
                                    <span>Available in @FormatDuration(plan.Feeding.TimeUntilTargetAvailable)</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="action-item">
                                <span class="action-icon green" aria-hidden="true">✓</span>
                                <div>
                                    <strong>@FormatDuration(DesiredBuffer) target buffer covered</strong>
                                    <span>@FeedingSupportingText</span>
                                </div>
                            </div>
                        }

                        <div class="action-item">
                            <span class="action-icon teal" aria-hidden="true">▰</span>
                            <div>
                                <strong>@FinalBabyFillTitle</strong>
                                <span>@FinalBabyFillText</span>
                            </div>
                        </div>
                    }
                    else if (maturityPercent >= 100)
                    {
                        <div class="action-item">
                            <span class="action-icon green" aria-hidden="true">✓</span>
                            <div>
                                <strong>Raise complete</strong>
                                <span>This creature has reached adulthood.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="action-item">
                            <span class="action-icon amber" aria-hidden="true">◷</span>
                            <div>
                                <strong>@FormatDuration(NextMaturationMilestoneDuration) until @NextMaturationMilestoneName</strong>
                                <span>@FormatPercent(maturityPercent) maturation complete</span>
                            </div>
                        </div>
                        <div class="action-item">
                            <span class="action-icon green" aria-hidden="true">✓</span>
                            <div>
                                <strong>@plan.FoodToAdult @CurrentFood.Name remaining</strong>
                                <span>Currently consuming about @ItemsPerHour.ToString("0.##") per hour</span>
                            </div>
                        </div>
                    }
                </section>

                <section class="card food-summary daily-food-card">
                    <div class="section-title compact">
                        <span class="section-icon" aria-hidden="true">◫</span>
                        <div>
                            <h2>Daily food <small>(@CurrentFood.Name)</small></h2>
                            <p><strong>@plan.TotalFoodFromBirth</strong> total needed for the full raise.</p>
                        </div>
                    </div>

                    <div class="daily-bars" aria-label="Daily food provisioning">
                        @foreach (var day in plan.DailyProvisioning.Take(5))
                        {
                            <div class="daily-bar-row">
                                <span>Day @day.Day</span>
                                <span class="bar-track">
                                    <span class="bar-fill" style="@BarStyle(day.ItemQuantity)"></span>
                                </span>
                                <strong>@day.ItemQuantity</strong>
                            </div>
                        }
                    </div>
                </section>

                <section class="card summary-card">
                    <div class="section-title compact">
                        <span class="section-icon" aria-hidden="true">▤</span>
                        <div>
                            <h2>Summary</h2>
                            <p>The essentials at a glance.</p>
                        </div>
                    </div>

                    <dl class="timeline-list">
                        @if (plan.Feeding.Status == FeedingBufferStatus.Juvenile)
                        {
                            <div>
                                <dt>Current phase</dt>
                                <dd>@CurrentPhase</dd>
                            </div>
                        }
                        else
                        {
                            <div>
                                <dt>@NextMaturationMilestoneLabel</dt>
                                <dd>@FormatDuration(NextMaturationMilestoneDuration)</dd>
                            </div>
                        }
                        @if (plan.Feeding.Status == FeedingBufferStatus.Juvenile
                            && maturityPercent < AdolescentThresholdPercent)
                        {
                            <div>
                                <dt>Adolescent in</dt>
                                <dd>@FormatDuration(plan.Lifecycle.TimeToAdolescent)</dd>
                            </div>
                        }
                        <div>
                            <dt>Adult in</dt>
                            <dd>@FormatDuration(plan.Lifecycle.TimeToAdult)</dd>
                        </div>
                        <div class="summary-food">
                            <dt>@CurrentFood.Name needed</dt>
                            <dd>@plan.FoodToAdult</dd>
                        </div>
                    </dl>
                    <details class="details-panel">
                        <summary>Calculation details</summary>
                        <dl class="detail-grid">
                            <div>
                                <dt>Current consumption</dt>
                                <dd>@plan.CurrentFoodPointsPerMinute.ToString("0.##") food points/min</dd>
                            </div>
                            <div>
                                <dt>Current items</dt>
                                <dd>@plan.CurrentItemsPerMinute.ToString("0.###") @CurrentFood.Name/min</dd>
                            </div>
                            <div>
                                <dt>Items spoiled in full inventory</dt>
                                <dd>@plan.Feeding.SpoiledItemQuantity</dd>
                            </div>
                            <div>
                                <dt>Food required to fill current capacity</dt>
                                <dd>@plan.Feeding.FoodRequiredToFillCurrentCapacity @CurrentFood.Name</dd>
                            </div>
                            <div>
                                <dt>Time to adult</dt>
                                <dd>@FormatDuration(plan.Lifecycle.TimeToAdult)</dd>
                            </div>
                            <div>
                                <dt>Egg/conception to adult</dt>
                                <dd>@FormatDuration(plan.Lifecycle.EggOrConceptionToAdultDuration)</dd>
                            </div>
                            <div>
                                <dt>Elapsed maturation</dt>
                                <dd>@FormatDuration(plan.Lifecycle.ElapsedMaturation)</dd>
                            </div>
                        </dl>
                        <label class="loss-field">
                            <span>Provisioning safety/loss</span>
                            <div class="input-with-suffix">
                                <input type="number" min="0" max="500" step="1"
                                       @bind="lossPercent"
                                       @bind:event="oninput"
                                       @bind:after="Recalculate" />
                                <span>%</span>
                            </div>
                        </label>
                    </details>
                </section>
            }
        </div>
    </div>
}

@code {
    private string selectedCreatureId = "argentavis";
    private string selectedFoodId = "";
    private double maturityPercent;
    private double adultWeight = 400;
    private int bufferHours = 1;
    private int bufferMinutes;
    private double lossPercent;
    private double greenhousePercent = 300;
    private bool shovelTilled;
    private double unofficialHatch = 1;
    private double unofficialMature = 1;
    private double unofficialConsume = 1;
    private RaisePlan? plan;
    private string? calculationError;

    private CreatureDefinition CurrentCreature =>
        Catalog.Catalog!.Creatures.First(item => item.Id == selectedCreatureId);

    private IReadOnlyList<FoodDefinition> AvailableFoods =>
        CurrentCreature.RaisingFoodIds
            .Select(id => Catalog.Catalog!.Foods.First(food => food.Id == id))
            .ToArray();

    private FoodDefinition CurrentFood =>
        AvailableFoods.First(item => item.Id == selectedFoodId);

    private bool RequiresRenderedBloodPackWarning =>
        CurrentCreature.SpecialBehavior == "blood-pack-render-required"
        && selectedFoodId == "blood-pack";

    private TimeSpan DesiredBuffer =>
        TimeSpan.FromHours(Math.Max(0, bufferHours))
        + TimeSpan.FromMinutes(Math.Clamp(bufferMinutes, 0, 59));

    private string CurrentPhase => maturityPercent switch
    {
        >= 100 => "Adult",
        _ when maturityPercent >= AdolescentThresholdPercent => "Adolescent",
        _ when maturityPercent >= JuvenileThresholdPercent => "Juvenile",
        _ => "Baby"
    };

    private double JuvenileThresholdPercent =>
        CurrentCreature.JuvenileThreshold * 100;

    private double AdolescentThresholdPercent =>
        MaturationThresholds.Adolescent * 100;

    private string BirthTrackLabel =>
        CurrentCreature.BirthMethod == BirthMethod.Gestation ? "Birth" : "Hatch";

    private string JuvenileTrackStyle =>
        $"--point-left:{JuvenileThresholdPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    private string TrackBoundaryState(double maturityThresholdPercent) =>
        maturityPercent + 0.0001 >= maturityThresholdPercent ? "active" : "";

    private string PhaseLabelState(string phase) =>
        string.Equals(CurrentPhase, phase, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    private string NextMaturationMilestoneName => maturityPercent switch
    {
        _ when maturityPercent < JuvenileThresholdPercent => "juvenile",
        _ when maturityPercent < AdolescentThresholdPercent => "adolescent",
        _ when maturityPercent < 100 => "adult",
        _ => "complete"
    };

    private string NextMaturationMilestoneLabel => maturityPercent switch
    {
        _ when maturityPercent < JuvenileThresholdPercent => "Juvenile in",
        _ when maturityPercent < AdolescentThresholdPercent => "Adolescent in",
        _ when maturityPercent < 100 => "Adult in",
        _ => "Complete"
    };

    private TimeSpan NextMaturationMilestoneDuration => maturityPercent switch
    {
        _ when maturityPercent < JuvenileThresholdPercent => plan!.Lifecycle.TimeToJuvenile,
        _ when maturityPercent < AdolescentThresholdPercent => plan!.Lifecycle.TimeToAdolescent,
        _ when maturityPercent < 100 => plan!.Lifecycle.TimeToAdult,
        _ => TimeSpan.Zero
    };

    private string NextMaturationMilestoneHelp => maturityPercent switch
    {
        _ when maturityPercent < JuvenileThresholdPercent => $"At {FormatPercent(JuvenileThresholdPercent)}",
        _ when maturityPercent < AdolescentThresholdPercent => $"At {FormatPercent(AdolescentThresholdPercent)}",
        _ when maturityPercent < 100 => "Remaining maturation",
        _ => "Raise complete"
    };

    private string JuvenileHeadline =>
        maturityPercent >= 100
            ? "Raise complete"
            : $"{FormatDuration(plan!.Lifecycle.TimeToAdult)} until adult";

    private string JuvenileSupportingText =>
        maturityPercent >= 100
            ? "The full lifecycle and food history remain available below."
            : $"{plan!.FoodToAdult} {CurrentFood.Name} remain at the selected server rates.";

    private double ItemsPerHour => (plan?.CurrentItemsPerMinute ?? 0) * 60;
    private double ItemsPerDay => ItemsPerHour * 24;

    private string MaturityStyle =>
        $"width:{Math.Clamp(maturityPercent, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";

    private string FeedingTone => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile => "success",
        FeedingBufferStatus.TargetMet => "success",
        FeedingBufferStatus.TargetAvailableLater => "attention",
        _ => "neutral"
    };

    private string FeedingSymbol => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile => "✓",
        FeedingBufferStatus.TargetMet => "✓",
        _ => "◷"
    };

    private string FeedingEyebrow => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile => "Trough-ready plan",
        FeedingBufferStatus.TargetMet => "Buffer target met",
        _ => "Buffer grows with maturity"
    };

    private string FeedingHeadline => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile => "Full inventory carries this baby to juvenile",
        FeedingBufferStatus.TargetMet => $"Full inventory covers your {FormatDuration(DesiredBuffer)} target buffer",
        _ => $"{FormatDuration(DesiredBuffer)} target buffer available in {FormatDuration(plan!.Feeding.TimeUntilTargetAvailable)}"
    };

    private string FeedingSupportingText => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile =>
            $"Current full-inventory buffer reaches juvenile in {FormatDuration(plan.Lifecycle.TimeToJuvenile)}.",
        FeedingBufferStatus.TargetMet =>
            $"Current full-inventory buffer is {FormatDuration(plan.Feeding.FullInventoryDuration)}.",
        FeedingBufferStatus.TargetAvailableLater =>
            $"Current full-inventory buffer is {FormatDuration(plan.Feeding.FullInventoryDuration)}; target buffer at {FormatPercent(plan.Feeding.TargetAvailableMaturityPercent)} maturity.",
        _ => ""
    };

    private string FinalBabyFillTitle => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile => "One full baby inventory reaches juvenile now",
        _ => $"Hand feed until {FormatPercent(plan!.Feeding.LastFullInventoryMaturityPercent)}"
    };

    private string FinalBabyFillText => plan?.Feeding.Status switch
    {
        FeedingBufferStatus.CarriesToJuvenile =>
            $"A full baby inventory of {plan!.Feeding.FullItemQuantity} {CurrentFood.Name} carries to {FormatPercent(JuvenileThresholdPercent)}.",
        _ =>
            $"Then fill at {FormatPercent(plan!.Feeding.LastFullInventoryMaturityPercent)} with {plan.Feeding.LastFullInventoryItemQuantity} {CurrentFood.Name} to carry to juvenile."
    };

    protected override async Task OnInitializedAsync()
    {
        Rates.Changed += RatesChanged;
        await Task.WhenAll(Catalog.EnsureLoadedAsync(), Rates.EnsureLoadedAsync());

        unofficialHatch = Rates.UnofficialRates.HatchSpeed;
        unofficialMature = Rates.UnofficialRates.MaturationSpeed;
        unofficialConsume = Rates.UnofficialRates.ConsumptionSpeed;

        if (Catalog.Catalog is not null)
        {
            if (!Catalog.Catalog.Creatures.Any(item => item.Id == selectedCreatureId))
            {
                selectedCreatureId = Catalog.Catalog.Creatures[0].Id;
            }

            CreatureChanged();
        }
    }

    private void CreatureChanged()
    {
        adultWeight = CurrentCreature.AdultWeight;
        selectedFoodId = AvailableFoods[0].Id;
        Recalculate();
    }

    private void Recalculate()
    {
        calculationError = null;
        if (Catalog.Catalog is null || Rates.CurrentRates is null)
        {
            plan = null;
            return;
        }

        if (!AvailableFoods.Any(item => item.Id == selectedFoodId))
        {
            selectedFoodId = AvailableFoods[0].Id;
        }

        try
        {
            plan = Calculator.Calculate(new RaiseRequest
            {
                Creature = CurrentCreature,
                Food = CurrentFood,
                ServerSelection = Rates.SelectedServer,
                Rates = Rates.CurrentRates,
                MaturityPercent = Math.Clamp(maturityPercent, 0, 100),
                AdultWeight = Math.Max(1, adultWeight),
                DesiredBuffer = DesiredBuffer,
                ProvisioningLossPercent = Math.Max(0, lossPercent),
                Elderclaw = new ElderclawSettings(greenhousePercent, shovelTilled),
                AsOf = DateTimeOffset.Now
            });
        }
        catch (Exception exception)
        {
            plan = null;
            calculationError = exception.Message;
        }
    }

    private async Task SaveUnofficialAsync()
    {
        if (unofficialHatch > 0 && unofficialMature > 0 && unofficialConsume > 0)
        {
            await Rates.SaveUnofficialAsync(
                new ServerRates(unofficialHatch, unofficialMature, unofficialConsume));
        }
    }

    private void RatesChanged()
    {
        InvokeAsync(() =>
        {
            Recalculate();
            StateHasChanged();
        });
    }

    private string BarStyle(int items)
    {
        var max = plan?.DailyProvisioning.Take(7).Max(item => item.ItemQuantity) ?? 1;
        var width = max <= 0 ? 0 : Math.Clamp(items * 100d / max, 3, 100);
        return $"width:{width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
    }

    private static string FormatRate(double rate) => $"{rate:0.##}×";
    private static string FormatPercent(double value) => $"{value:0.#}%";

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration <= TimeSpan.Zero)
        {
            return "0m";
        }

        var parts = new List<string>();
        if (duration.Days > 0) parts.Add($"{duration.Days}d");
        if (duration.Hours > 0) parts.Add($"{duration.Hours}h");
        if (duration.Minutes > 0 || parts.Count == 0) parts.Add($"{duration.Minutes}m");
        return string.Join(" ", parts.Take(2));
    }

    public void Dispose() => Rates.Changed -= RatesChanged;
}
